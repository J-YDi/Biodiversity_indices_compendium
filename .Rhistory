}
breakaway_EPIE <- rep(1,50)
for (i in 1:nrow(BCI)){
breakaway_EPIE[i] <- breakaway::true_shannon_e(BCI_relat[i,]) # Pielou
}
# Put all the values in a single dataframe
EPIE <- ls(pattern = "_EPIE")
EPIE <- mget(EPIE)
EPIE <- as.data.frame(EPIE)
# Sheldon ####
sheldon_index <- function(x, base = exp(1), na.rm = TRUE) {
x <- as.numeric(x)
if (na.rm) x <- x[!is.na(x)]
x <- x[x > 0]
N <- sum(x)
if (N == 0 || length(x) < 2) return(NA_real_)
p <- x / N
H <- -sum(p * log(p, base = base))
S <- length(p)
Sh <- exp(H) / S
return(Sh)
}
custom_ESHE <- rep(1,50)
for (i in 1:nrow(BCI)){
custom_ESHE[i] <- sheldon_index(BCI[i,])
}
# Put all the values in a single dataframe
ESHE <- ls(pattern = "_ESHE")
ESHE <- mget(ESHE)
ESHE <- as.data.frame(ESHE)
# Inv Simpson Evenness ####
tabula_ESP <- as.numeric(tabula::evenness(BCI,method = "simpson")) # Inv Simpson E
sprex_ESP <- rep(1,50)
for (i in 1:nrow(BCI)){
sprex_ESP[i] <- sprex::diversity(as.numeric(BCI[i,]),type = "eveness.simpson") #FALSE
}
adiv_ESP <- adiv::specieseve(BCI,method = "Simpson")[,1] # Inv Simpson E
codyn_ESP <- rep(1,50)
for (i in 1:nrow(BCI)){
BCI_long <- tidyr::pivot_longer(BCI[i,],cols = colnames(BCI)[1]:colnames(BCI)[35],names_to = "Esp",values_to = "Value")
BCI_long <- BCI_long[1:35,]
codyn_ESP[i] <- codyn::community_structure(BCI_long,abundance.var = "Value",metric = "SimpsonEvenness")$SimpsonEvenness
}
# Put all the values in a single dataframe
ESP <- ls(pattern = "_ESP")
ESP <- mget(ESP)
ESP <- as.data.frame(ESP)
# Strong ####
abdiv_EST <- rep(1,50)
for (i in 1:nrow(BCI)){
abdiv_EST [i] <- abdiv::strong(as.numeric(BCI[i,]))
}
# Put all the values in a single dataframe
EST <- ls(pattern = "_EST")
EST <- mget(EST)
EST <- as.data.frame(EST)
# Indicate species richness for next analysis
custom_RICH <- rep(1,50)
for (i in 1:nrow(BCI)){
custom_RICH [i] <- sum(BCI[i,] > 0)
}
custom_RICH <- as.data.frame(custom_RICH)
