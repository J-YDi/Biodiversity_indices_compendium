x1 <- varespec[1,]
x2 <- varespec[2,]
varespec_2 <- varespec * 2
x12 <- varespec[1:2,]
x12_pa <- ifelse(x12 != 0, 1, 0)
x1int <- as.integer(varespec[1,])
x2int <- as.integer(varespec[2,])
x12int <- rbind(x1int,x2int)
View(x12_pa)
