# McNaughton ####
mcnaughton_index <- function(x, na.rm = TRUE) {
x <- as.numeric(x)
if (na.rm) x <- x[!is.na(x)]
x <- x[x > 0]
if (length(x) == 0) return(NA_real_)
# Total et 2 espèces dominantes
N <- sum(x)
top2 <- sort(x, decreasing = TRUE)[1:min(2, length(x))]
D <- sum(top2) / N
return(D)
}
