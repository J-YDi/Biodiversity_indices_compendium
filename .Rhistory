# Ludwig-Reynolds ####
#### Ludwig-Reynold ####
Ludwig_Reynold <- function(abondances) {
N <- sum(abondances)
S <- sum(abondances > 0)  # Nombre d'espèces présentes
p_i <- abondances / N
p_i <- p_i[p_i > 0]
H_prime <- -sum(p_i * log(p_i))
if (S <= 1) {
return(NA)  # Évitons une division par zéro
}
E <- exp(H_prime - 1) / (S - 1)
return(E)
}
